---
import VideoEmbed from './VideoEmbed.astro';

interface Props {
  title?: string;
  youtubeId?: string;
  videoTitle?: string;
}

const {
  title,
  youtubeId = 'BO0Ern9gcOI',
  videoTitle = 'Presentación del OTP Challenge',
} = Astro.props;
---

<header class="mb-10 text-center">
  <h1 class="text-4xl font-medium mb-1">
    <slot name="title">{title}</slot>
  </h1>
</header>

<!-- Vídeo de presentación -->
<div class="mb-12">
  <VideoEmbed youtubeId={youtubeId} title={videoTitle} />
</div>