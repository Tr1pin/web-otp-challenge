---
import ChampionCard from './ChampionCard.astro';
import type { Champion } from '../types';

interface Props {
  champions: Champion[];
}

const { champions } = Astro.props;
---

{champions.length === 0 ? (
  
  <div class="text-center py-20 text-slate-400">
    <i class="ti ti-mood-empty text-5xl text-slate-500 block mb-4"></i>
    No hay champions para mostrar ahora mismo.
  </div>

) : (

  <article class="champ-grid grid grid-cols-1 md:grid-cols-2 gap-20">
    {champions.map((champion) => <ChampionCard champion={champion} />)}
  </article>

)}