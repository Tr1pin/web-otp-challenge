---
import type { Video } from '../types';

interface Props {
  videos: Video[];
  championName: string;
  collaboratorName: string;
}

const { videos, championName, collaboratorName } = Astro.props;
const collabCapitalized = collaboratorName.charAt(0).toUpperCase() + collaboratorName.slice(1);
---

{videos.length > 0 && (
  <section aria-labelledby="videos-heading">
    <hr class="border-0 h-px bg-hextech/80 my-25 mb-28" />
    <h2 id="videos-heading" class="text-2xl font-medium text-hextech mb-1">
      Todos los videos con {championName}
    </h2>
    <p class="text-slate-400 mb-8 ml-1">{championName} × {collabCapitalized}</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {videos.map((video) => (
        <article class="group relative w-full aspect-video rounded-xl overflow-hidden border-[0.5px] border-surface-border hover:border-hextech transition-colors">
          <a href={video.watchUrl ?? '#'} target="_blank" rel="noopener noreferrer" class="block w-full h-full">
            <img src={video.thumbnailUrl} alt={`Miniatura: ${video.title}`} class="absolute inset-0 w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black/30 group-hover:from-black/70 transition-colors"></div>
            <h3 class="absolute top-4 left-4 text-lg font-medium text-white drop-shadow-lg">{video.title}</h3>
          </a>
        </article>
      ))}
    </div>
  </section>
)}