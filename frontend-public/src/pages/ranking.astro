---
import Layout from '../layouts/Layout.astro';
import RankingTitle from '../components/astro/RankingTitle.astro';
import type { Champion } from '../types';

let champions: Champion[] = [];

try {
  const res = await fetch('http://localhost:8080/api/champions?sort=votes');
  if (!res.ok) throw new Error('API respondió con error');
  champions = await res.json();
} catch (e) {
  console.error('Api error');
}

const top = champions.slice(0, 5);

function rankColor(pos: number) {
  if (pos === 1) return 'text-[#facc15]'; // oro
  if (pos === 2) return 'text-[#cbd5e1]'; // plata
  if (pos === 3) return 'text-[#d98a4b]'; // bronce
  return 'text-slate-500';
}
---

<Layout title="Ranking - OTP Challenge">
  <main class="max-w-xl mx-auto px-4 py-10">

    <RankingTitle />

    {top.length === 0 ? (
      <div class="text-center py-20 text-slate-400">
        <i class="ti ti-mood-empty text-5xl text-slate-500 block mb-4"></i>
        No hay campeones para mostrar ahora mismo.
      </div>
    ) : (
      <ol class="list-none p-0 m-0 flex flex-col gap-3 items-center">
        {top.map((champion, i) => {
          const pos = i + 1;
          const winRatio = Math.round(champion.winRatio ?? 0);
          const collaboratorName = champion.collaborator?.name ?? 'Desconocido';
          const collaboratorPhoto = champion.collaborator?.photoUrl;
          const initial = collaboratorName.charAt(0).toUpperCase();
          const championSplash = champion.photoUrl
            ? champion.photoUrl
            : `https://ddragon.leagueoflegends.com/cdn/img/champion/splash/${champion.championKey}_0.jpg`;

          return (
            <li>
              <a
                href={`/champion/${champion.id}`}
                class="inline-flex items-center gap-5 w-fit bg-surface border-[0.5px] border-surface-border rounded-xl px-5 pt-5.5 pb-3 no-underline transition-colors hover:border-hextech"
              >
                {/* Puesto */}
                <span class={`text-4xl font-medium w-12 text-center shrink-0 ${rankColor(pos)}`}>
                  {pos}º
                </span>


                <div class="flex flex-col items-center gap-3">

                  {/* Campeon y colaborador con nombre */}
                  <div class="flex flex-col sm:flex-row items-center gap-3">
                    <figure class="relative w-60 h-60 shrink-0 rounded-lg overflow-hidden border border-gray-50/30 flex items-center justify-center m-0">
                      {collaboratorPhoto
                        ? <img src={collaboratorPhoto} alt={`Foto de ${collaboratorName}`} class="w-full h-full object-cover" />
                        : <span class="text-slate-300 text-4xl font-medium">{initial}</span>
                      }
                      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent pt-6 pb-1.5 px-2">
                        <span class="block text-slate-100 text-lg font-medium text-center truncate">{collaboratorName}</span>
                      </div>
                    </figure>

                    <span class="text-hextech text-2xl font-medium shrink-0" aria-hidden="true">×</span>

                    <figure class="relative w-60 h-60 shrink-0 rounded-lg overflow-hidden border border-gray-50/30 m-0">
                      <img src={championSplash} alt={`Splash art de ${champion.name}`} loading="lazy" class="w-full h-full object-cover object-top" />
                      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent pt-6 pb-1.5 px-2">
                        <span class="block text-slate-100 text-lg font-medium text-center truncate">{champion.name}</span>
                      </div>
                    </figure>
                  </div>

                  {/* Votos + WR debajo */}
                  <div class="flex justify-center gap-8">
                    <div class="text-center">
                      <div class="flex items-center gap-1.5 justify-center">
                        <span class="text-slate-100 text-xl font-medium">{champion.voteCount ?? 0}</span>
                      </div>
                      <div class="text-slate-400 text-[11px] mt-1">votos</div>
                    </div>
                    <div class="text-center">
                      <div class="text-hextech text-xl font-medium">{winRatio}%</div>
                      <div class="text-slate-400 text-[11px] mt-1">WR</div>
                    </div>
                  </div>

                </div>

                <span class={`w-12`}>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    )}

  </main>
</Layout>