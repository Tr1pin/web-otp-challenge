---
import Layout from '../layouts/Layout.astro';
import AuthForm from '../components/islands/AuthForm.tsx';
---

<Layout title="Entrar — OTP Challenge">
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-6xl flex flex-col md:flex-row rounded-2xl overflow-hidden border-[0.5px] border-surface-border min-h-[560px]">

      <!-- Branding (izquierda) -->
      <div class="flex-1 bg-gradient-to-br from-[#0d2a30] to-page flex flex-col justify-center p-12">
        <div class="text-hextech text-sm tracking-widest mb-3">OTP CHALLENGE</div>
        <div class="text-slate-100 text-3xl font-medium leading-snug mb-3">
          Vota por tu<br />campeón favorito
        </div>
        <div class="text-slate-400 text-base leading-relaxed">
          Entra para participar en las votaciones del OTP Challenge de Werlyb.
        </div>
      </div>

      <!-- Formulario (derecha) -->
      <div class="flex-1 bg-surface flex flex-col justify-center p-12">
        <AuthForm client:load />
      </div>

    </div>
  </div>
</Layout>