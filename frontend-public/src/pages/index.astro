---
import Layout from '../layouts/Layout.astro';
import GalleryWithSort from '../components/islands/GalleryWithSort';
import VideoSection from '../components/astro/VideoSection.astro';
import type { Champion } from '../types';

let champions: Champion[] = [];

try {
  
  const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
  const res = await fetch(`${API_URL}/api/champions`);

  if (!res.ok) throw new Error('API respondió con error');
  champions = await res.json();
} catch (e) {
  console.error('Api error');
}
---

<Layout title="OTP - Challenge">
  <main class="max-w-6xl mx-auto px-6 py-10">
    <VideoSection>
      <span slot="title" class="block leading-tight">
        <span class="block text-white text-2xl md:text-3xl lg:text-4xl tracking-[0.3em] my-3 italic">siendo</span>
        <span class="block text-hextech text-5xl md:text-7xl lg:text-7xl font-bold tracking-[0.15em] my-3">OTP</span>
        <span class="block text-white text-2xl md:text-3xl lg:text-4xl tracking-[0.3em] my-3 italic">por un día</span>
      </span>
    </VideoSection>
    <hr class="my-20 bg-page/30 border-b border-gray-100/10" id="gallery-header"/>
    <GalleryWithSort client:load champions={champions} />
  </main>
</Layout>