---
import Layout from '../layouts/Layout.astro';
import HomeTitle from '../components/HomeTitle.astro';
import Gallery from '../components/Gallery.astro';
import type { Champion } from '../types';

let champions: Champion[] = [];

try {
  const res = await fetch('http://localhost:8080/api/champions');
  if (!res.ok) throw new Error('API respondió con error');
  champions = await res.json();
} catch (e) {
  console.error('Api error');
}
---

<Layout title="OTP - Challenge">
  <main class="max-w-6xl mx-auto px-4 py-10">
    <HomeTitle />
    <Gallery champions={champions} />
  </main>
</Layout>